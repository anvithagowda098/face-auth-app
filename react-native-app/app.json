{
  "expo": {
    "name": "Sentinel",
    "slug": "edge-face-sentinel",
    "scheme": "sentinel",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "backgroundColor": "#0B0F14",
    "ios": {
      "bundleIdentifier": "com.nhai.edgefacesentinel",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to authenticate toll-plaza workers by face."
      }
    },
    "android": {
      "package": "com.nhai.edgefacesentinel",
      "edgeToEdgeEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "onnxruntime-react-native",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Used to authenticate toll-plaza workers by face.",
          "enableFrameProcessors": true,
          "disableMicrophonePermission": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "877b488c-083f-40d7-99de-ddec36023966"
      }
    }
  }
}
