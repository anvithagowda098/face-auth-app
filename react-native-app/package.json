    "expo-secure-store": "~14.2.3",
    "expo-sqlite": "~15.2.10",
    "expo-status-bar": "~2.2.3",
    "js-sha256": "^0.11.0",
    "onnxruntime-react-native": "^1.20.1",
    "react": "19.0.0",
